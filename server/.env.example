# Server
PORT=5000
NODE_ENV=development
# Where the React app runs (used for CORS and Stripe redirect URLs)
CLIENT_URL=http://localhost:5173

# MongoDB (local or a free MongoDB Atlas cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/shopsphere

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Payments: "mock" works with no keys (great for demos); "stripe" uses Stripe Checkout in test mode
PAYMENT_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: force secure cookies on/off (default: on when NODE_ENV=production)
# COOKIE_SECURE=false
